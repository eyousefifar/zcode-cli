{
  "name": "@eyousefifar/zcode-cli",
  "version": "0.16.5",
  "description": "Unofficial standalone distribution of the ZCode CLI (the agent engine from the ZCode desktop app) — single binary via bun compile, or a thin package that runs on bun.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "bin": {
    "zcode": "./dist-npm/entry.js"
  },
  "files": [
    "dist-npm/",
    "vendor/zcode-builtin.json",
    "vendor/cli-settings-default.json",
    "README.md",
    "LICENSE-NOTE"
  ],
  "engines": {
    "bun": ">=1.1.21"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "bash scripts/test.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyousefifar/zcode-cli.git"
  },
  "keywords": [
    "zcode",
    "zai",
    "glm",
    "cli",
    "agent",
    "coding-assistant"
  ],
  "author": "Erfan Yousefifar",
  "devDependencies": {
    "@earendil-works/pi-tui": "0.85.1",
    "@xterm/headless": "6.0.0",
    "@zcode/tui": "file:./stubs/@zcode/tui-real",
    "beautiful-mermaid": "^1.1.3",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "playwright-core": "file:./stubs/playwright-core"
  }
}
